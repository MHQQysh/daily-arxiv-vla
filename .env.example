# DeepSeek 官方 API 配置
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# arXiv 爬虫配置：不设置 ARXIV_QUERY_KEYWORD 时启用七组自动驾驶检索
ARXIV_KEYWORD_LABEL=自动驾驶
ARXIV_INIT_RESULTS=80
ARXIV_DAILY_RESULTS=10
# 过滤、去重并排除已有论文后，全站单次最终写入 1-5 篇
ARXIV_DAILY_TOTAL_LIMIT=5
ARXIV_PAGE_SIZE=20
ARXIV_DELAY_SECONDS=10
ARXIV_RETRY_BASE_SECONDS=30
ARXIV_MAX_RETRIES=3
# ARXIV_QUERY_KEYWORD=all:"your custom query"

# HTTP 请求配置
HTTP_MAX_RETRIES=3
HTTP_TIMEOUT=30
HTML_MAX_CHARS=180000

# API 调用配置
API_MAX_RETRIES=3
SUMMARY_MAX_TOKENS=2048

# 性能优化配置
# 每次运行固定最多处理 5 篇；并发数也不会超过本轮任务数
SUMMARY_WORKERS=5
BATCH_WRITE_SIZE=5
